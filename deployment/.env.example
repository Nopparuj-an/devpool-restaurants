# Copy with `make env` (fills the secrets automatically). Never commit .env.

POSTGRES_USER=restaurants
POSTGRES_PASSWORD=__RANDOM_HEX_16__
POSTGRES_DB=restaurants

# Garage (S3). Key ID must be "GK" + 24 hex chars, secret 64 hex chars.
GARAGE_RPC_SECRET=__RANDOM_HEX_32__
GARAGE_ADMIN_TOKEN=__RANDOM_HEX_32__
S3_ACCESS_KEY_ID=GK__RANDOM_HEX_12__
S3_SECRET_ACCESS_KEY=__RANDOM_HEX_32__
S3_BUCKET=restaurant-images
S3_REGION=garage

# Google login (optional). Create an OAuth client (Web application) in Google
# Cloud Console with redirect URI http://localhost:3000/api/auth/google/callback.
# Leave GOOGLE_CLIENT_ID empty to disable the "Sign in with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
